<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0"
         metadata-complete="false">
  <display-name>Seminar Certificate Platform</display-name>

  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

  <listener>
    <listener-class>com.certify.AppContextListener</listener-class>
  </listener>

  <filter>
    <filter-name>EncodingFilter</filter-name>
    <filter-class>com.certify.filter.EncodingFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>EncodingFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <filter>
    <filter-name>AuthFilter</filter-name>
    <filter-class>com.certify.filter.AuthFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>AuthFilter</filter-name>
    <url-pattern>/admin</url-pattern>
    <url-pattern>/admin/*</url-pattern>
    <url-pattern>/developer</url-pattern>
    <url-pattern>/developer/*</url-pattern>
  </filter-mapping>

  <servlet>
    <servlet-name>LoginServlet</servlet-name>
    <servlet-class>com.certify.servlet.LoginServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LoginServlet</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>LogoutServlet</servlet-name>
    <servlet-class>com.certify.servlet.LogoutServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LogoutServlet</servlet-name>
    <url-pattern>/logout</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>TemplateImageServlet</servlet-name>
    <servlet-class>com.certify.servlet.TemplateImageServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>TemplateImageServlet</servlet-name>
    <url-pattern>/media/template</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>AdminDashboardServlet</servlet-name>
    <servlet-class>com.certify.servlet.admin.AdminDashboardServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AdminDashboardServlet</servlet-name>
    <url-pattern>/admin</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>SeminarFormServlet</servlet-name>
    <servlet-class>com.certify.servlet.admin.SeminarFormServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>SeminarFormServlet</servlet-name>
    <url-pattern>/admin/seminars/new</url-pattern>
    <url-pattern>/admin/seminars/edit</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>SeminarDetailServlet</servlet-name>
    <servlet-class>com.certify.servlet.admin.SeminarDetailServlet</servlet-class>
    <multipart-config>
      <max-file-size>12582912</max-file-size>
      <file-size-threshold>1048576</file-size-threshold>
    </multipart-config>
  </servlet>
  <servlet-mapping>
    <servlet-name>SeminarDetailServlet</servlet-name>
    <url-pattern>/admin/seminars</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>DeveloperQueueServlet</servlet-name>
    <servlet-class>com.certify.servlet.dev.DeveloperQueueServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>DeveloperQueueServlet</servlet-name>
    <url-pattern>/developer</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>AdminAccountsServlet</servlet-name>
    <servlet-class>com.certify.servlet.dev.AdminAccountsServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AdminAccountsServlet</servlet-name>
    <url-pattern>/developer/admins</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>AlignmentServlet</servlet-name>
    <servlet-class>com.certify.servlet.dev.AlignmentServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AlignmentServlet</servlet-name>
    <url-pattern>/developer/align</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>PublicCertificateServlet</servlet-name>
    <servlet-class>com.certify.servlet.pub.PublicCertificateServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>PublicCertificateServlet</servlet-name>
    <url-pattern>/c/*</url-pattern>
  </servlet-mapping>

  <session-config>
    <session-timeout>60</session-timeout>
    <cookie-config>
      <http-only>true</http-only>
    </cookie-config>
  </session-config>
  <error-page>
    <error-code>403</error-code>
    <location>/WEB-INF/jsp/error.jsp</location>
  </error-page>
  <error-page>
    <error-code>404</error-code>
    <location>/WEB-INF/jsp/error-404.jsp</location>
  </error-page>
  <error-page>
    <error-code>500</error-code>
    <location>/WEB-INF/jsp/error.jsp</location>
  </error-page>
</web-app>
